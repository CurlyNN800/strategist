{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Одна запись evidence.jsonl",
  "type": "object",
  "required": ["id", "claim", "type", "confidence", "status", "topics", "stage", "added"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^E\\d{3,}$"},
    "claim": {"type": "string", "minLength": 1},
    "type": {"enum": ["fact", "hypothesis", "forecast", "synthetic"]},
    "source": {"type": ["string", "null"], "pattern": "^S\\d{3,}$"},
    "where": {"type": ["string", "null"]},
    "basis": {"type": ["string", "null"]},
    "confidence": {"enum": ["high", "medium", "low"]},
    "status": {"enum": ["active", "revoked"]},
    "revoked_by": {"type": ["string", "null"]},
    "revoked_reason": {"type": ["string", "null"]},
    "topics": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}},
    "stage": {"enum": ["01-intake", "02-collect", "03-research", "04-options", "05-decision", "06-strategy", "07-validation", "revise"]},
    "added": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"type": {"const": "fact"}}},
      "then": {"required": ["source", "where"], "properties": {"source": {"type": "string"}, "where": {"type": "string"}}}
    },
    {
      "if": {"properties": {"type": {"const": "synthetic"}}},
      "then": {"required": ["source"], "properties": {"source": {"type": "string"}}}
    },
    {
      "if": {"properties": {"type": {"enum": ["hypothesis", "forecast"]}}},
      "then": {"required": ["basis"], "properties": {"basis": {"type": "string", "minLength": 1}}}
    },
    {
      "if": {"properties": {"status": {"const": "revoked"}}},
      "then": {"required": ["revoked_by", "revoked_reason"], "properties": {"revoked_by": {"type": "string"}, "revoked_reason": {"type": "string"}}}
    }
  ]
}
