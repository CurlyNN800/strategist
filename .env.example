# Скопируйте этот файл в .env и впишите свои ключи. Файл .env в репозиторий не попадает.
# Нужны только ключи тех моделей и сервисов, которыми вы реально пользуетесь.

# Сильная модель (анализ, стратегия) — укажите провайдера, которого выбрала команда
STRONG_MODEL_API_KEY=

# Дешёвая модель (извлечение фактов, классификация), например GigaChat
CHEAP_MODEL_API_KEY=

# Веб-поиск, если среде не хватит встроенного (необязательно)
SEARCH_API_KEY=
